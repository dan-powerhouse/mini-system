# Leave both Supabase values blank to open the Harbor preview.
# For your project, use the project URL and the publishable (or anon) key.
# Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects can use the anon key under this name instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Links to the existing identity host for passkeys and OAuth consent.
# Sign in to the registry with email on this origin. OAuth client tokens are
# not registry sessions (registry_direct_principal rejects client_id).
NEXT_PUBLIC_IDENTITY_URL=http://localhost:3000

# Local `supabase start` (CLI 2.76.8, Docker) prints the API URL and anon key:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from supabase status>
# Add http://127.0.0.1:43127 to the Auth site URL and redirect allow list.
