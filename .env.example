# Login-only Next.js identity host: public values only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Never put service role credentials in frontend environment.
# Edge-only values, configured via Supabase secrets (not browser env):
MCP_ALLOWED_HOSTS=localhost:54321,127.0.0.1:54321
MCP_ALLOWED_ORIGINS=
# Edge secrets (supabase secrets set ...). Optional current API keys; legacy injected keys are the fallback.
# REGISTRY_SECRET_KEY=
# REGISTRY_PUBLISHABLE_KEY=
# Shared with Vault secret exchange_cleanup_secret; >= 32 random characters.
# EXCHANGE_CLEANUP_SECRET=
